{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-graph:schemas:tasks.v1",
  "title": "Tasks Document",
  "type": "object",
  "required": ["title", "version", "epics"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "epics": { "type": "array", "items": { "$ref": "#/$defs/TaskItem" }, "x-ui": { "display": "list", "section": "main", "order": 1, "itemTitle": "id+title" } }
  },
  "$defs": {
    "Relation": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["requirement", "design"] },
        "id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TaskItem": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^TASK-[A-Z]{3,4}-\\d{3}$" },
        "title": { "type": "string" },
        "type": { "enum": ["feature", "bug", "chore", "doc"], "default": "feature" },
        "status": { "enum": ["todo", "in-progress", "review", "done", "deferred", "cancelled"], "x-ui": { "display": "badge" } },
        "priority": { "enum": ["critical", "high", "medium", "low"], "x-ui": { "display": "badge" } },
        "assignee": { "type": "string", "pattern": "^STK-\\d{3}$" },
        "estimate": { "type": "number", "minimum": 0 },
        "dueDate": { "type": "string", "format": "date-time" },
        "relatesTo": { "type": "array", "items": { "$ref": "#/$defs/Relation" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/TaskItem" } },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "x-ui": { "display": "chips" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
