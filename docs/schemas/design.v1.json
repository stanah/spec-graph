{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-graph:schemas:design.v1",
  "title": "Design Document",
  "type": "object",
  "required": ["title", "version", "components"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/Component" },
      "x-ui": { "display": "list", "section": "main", "order": 1, "itemTitle": "id+name" }
    }
  },
  "$defs": {
    "Component": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^DSG-[A-Z]{3,4}-\\d{3}$" },
        "name": { "type": "string" },
        "type": { "enum": ["service", "module", "ui", "library", "adapter"] },
        "responsibilities": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^DSG-[A-Z]{3,4}-\\d{3}$" } },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "dataModels": { "type": "array", "items": { "type": "string" } },
        "techStack": { "type": "array", "items": { "enum": ["typescript", "react", "vite", "vitest", "zod", "d3", "vscode-api", "ajv"] } },
        "criticality": { "enum": ["low", "medium", "high"] },
        "risks": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Component" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
