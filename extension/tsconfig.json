{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "out",
        "lib": [
            "ES2020"
        ],
        "sourceMap": true,
        "strict": true,
        "moduleResolution": "node",
        "baseUrl": "./",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "typeRoots": ["./node_modules/@types"],
        "types": ["vscode", "node"]
    },
    "include": [
        "src/**/*",
        "../src/**/*"
    ],
    "exclude": [
        "node_modules",
        "../node_modules",
        ".vscode-test",
        "out",
        "src/test/**/*",
        "../src/**/*.test.ts",
        "../src/**/__tests__/**/*"
    ]
}