{
  "name": "document-viewer",
  "displayName": "Document Viewer",
  "description": "JSON/YAMLファイルの構造化ドキュメントを表示・編集するVSCode拡張",
  "version": "0.7.0",
  "publisher": "document-viewer",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "document",
    "mindmap",
    "json",
    "yaml",
    "visualization",
    "diagram"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:json",
    "onLanguage:yaml",
    "onCommand:documentViewer.openDocument",
    "onCommand:documentViewer.createNewDocument",
    "onView:documentTree",
    "onView:documentPreview",
    "workspaceContains:**/*.mindmap.{json,yaml,yml}",
    "workspaceContains:**/*.{json,yaml,yml}"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "documentViewer.openMindmap",
        "title": "ドキュメントを開く",
        "category": "Document Viewer"
      },
      {
        "command": "documentViewer.createNewMindmap",
        "title": "新しいドキュメントを作成",
        "category": "Document Viewer"
      },
      {
        "command": "documentViewer.exportMindmap",
        "title": "ドキュメントをエクスポート",
        "category": "Document Viewer"
      },
      {
        "command": "documentViewer.validateSchema",
        "title": "スキーマを検証",
        "category": "Document Viewer"
      },
      {
        "command": "documentViewer.refreshMindmapTree",
        "title": "ドキュメントツリーを更新",
        "category": "Document Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "documentViewer.selectNode",
        "title": "ノードを選択",
        "category": "Document Viewer"
      },
      {
        "command": "documentViewer.addChildNode",
        "title": "子ノードを追加",
        "category": "Document Viewer",
        "icon": "$(add)"
      },
      {
        "command": "documentViewer.addSiblingNode",
        "title": "兄弟ノードを追加",
        "category": "Document Viewer",
        "icon": "$(add)"
      },
      {
        "command": "documentViewer.deleteNode",
        "title": "ノードを削除",
        "category": "Document Viewer",
        "icon": "$(trash)"
      },
      {
        "command": "documentViewer.editNode",
        "title": "ノードを編集",
        "category": "Document Viewer",
        "icon": "$(edit)"
      },
      {
        "command": "documentViewer.collapseAll",
        "title": "すべて折りたたみ",
        "category": "Document Viewer",
        "icon": "$(collapse-all)"
      },
      {
        "command": "documentViewer.expandAll",
        "title": "すべて展開",
        "category": "Document Viewer",
        "icon": "$(expand-all)"
      },
      {
        "command": "documentViewer.generateCode",
        "title": "コードを生成",
        "category": "Document Viewer",
        "icon": "$(file-code)"
      },
      {
        "command": "documentViewer.previewCodeGeneration",
        "title": "コード生成をプレビュー",
        "category": "Document Viewer",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "documentViewer.openMindmap",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "documentViewer.openMindmap",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "documentViewer.openMindmap",
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml"
        }
      ],
      "view/title": [
        {
          "command": "documentViewer.refreshMindmapTree",
          "when": "view == documentTree",
          "group": "navigation"
        },
        {
          "command": "documentViewer.collapseAll",
          "when": "view == documentTree",
          "group": "navigation"
        },
        {
          "command": "documentViewer.expandAll",
          "when": "view == documentTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "documentViewer.addChildNode",
          "when": "view == documentTree && viewItem == documentRoot",
          "group": "inline"
        },
        {
          "command": "documentViewer.addChildNode",
          "when": "view == documentTree && viewItem == documentNode",
          "group": "inline"
        },
        {
          "command": "documentViewer.addSiblingNode",
          "when": "view == documentTree && viewItem == documentNode",
          "group": "inline"
        },
        {
          "command": "documentViewer.editNode",
          "when": "view == documentTree && (viewItem == documentRoot || viewItem == documentNode)",
          "group": "inline"
        },
        {
          "command": "documentViewer.deleteNode",
          "when": "view == documentTree && viewItem == documentNode",
          "group": "inline"
        },
        {
          "command": "documentViewer.addChildNode",
          "when": "view == documentTree && viewItem == documentRoot",
          "group": "1_add"
        },
        {
          "command": "documentViewer.addChildNode",
          "when": "view == documentTree && viewItem == documentNode",
          "group": "1_add"
        },
        {
          "command": "documentViewer.addSiblingNode",
          "when": "view == documentTree && viewItem == documentNode",
          "group": "1_add"
        },
        {
          "command": "documentViewer.editNode",
          "when": "view == documentTree && (viewItem == documentRoot || viewItem == documentNode)",
          "group": "2_edit"
        },
        {
          "command": "documentViewer.deleteNode",
          "when": "view == documentTree && viewItem == documentNode",
          "group": "3_delete"
        }
      ]
    },
    "configuration": {
      "title": "Document Viewer",
      "properties": {
        "documentViewer.editor.theme": {
          "type": "string",
          "enum": [
            "vs",
            "vs-dark",
            "hc-black"
          ],
          "default": "vs-dark",
          "description": "エディタのテーマ"
        },
        "documentViewer.editor.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 8,
          "maximum": 40,
          "description": "エディタのフォントサイズ"
        },
        "documentViewer.mindmap.layout": {
          "type": "string",
          "enum": [
            "tree",
            "radial"
          ],
          "default": "tree",
          "description": "マインドマップのレイアウト"
        },
        "documentViewer.mindmap.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto",
          "description": "マインドマップのテーマ（autoはVSCodeテーマに従う）"
        },
        "documentViewer.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "スキーマ検証を有効にする"
        },
        "documentViewer.validation.showWarnings": {
          "type": "boolean",
          "default": true,
          "description": "警告を表示する"
        },
        "documentViewer.autoSave.enabled": {
          "type": "boolean",
          "default": true,
          "description": "自動保存を有効にする"
        },
        "documentViewer.autoSave.delay": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 10000,
          "description": "自動保存の遅延時間（ミリ秒）"
        },
        "documentViewer.preview.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "アクティブなエディタにプレビューを自動追従させる"
        },
        "documentViewer.preview.autoOpenOnFileOpen": {
          "type": "boolean",
          "default": true,
          "description": "対応ファイルを開いたとき、プレビューが開いていなければ自動で表示する"
        }
      }
    },
    "languages": [
      {
        "id": "mindmap-json",
        "aliases": [
          "Mindmap JSON"
        ],
        "extensions": [
          ".mindmap.json"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mindmap-yaml",
        "aliases": [
          "Mindmap YAML"
        ],
        "extensions": [
          ".mindmap.yaml",
          ".mindmap.yml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.mindmap.json",
        "url": "./schemas/mindmap-data.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.mindmap.yaml",
        "url": "./schemas/mindmap-data.schema.json"
      },
      {
        "fileMatch": "*.mindmap.yml",
        "url": "./schemas/mindmap-data.schema.json"
      }
    ],
    "views": {
      "documentExplorer": [
        {
          "id": "documentTree",
          "name": "ドキュメントツリー",
          "when": "workspaceHasMinMindmapFiles || documentViewer.isActive",
          "contextualTitle": "ドキュメントツリー"
        },
        {
          "id": "documentPreview",
          "name": "ドキュメントプレビュー",
          "type": "webview",
          "contextualTitle": "ドキュメントプレビュー"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "documentExplorer",
          "title": "Document Viewer",
          "icon": "$(files)"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "documentViewer.documentEditor",
        "displayName": "Document Viewer",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          },
          {
            "filenamePattern": "*.mindmap.json"
          },
          {
            "filenamePattern": "*.mindmap.yaml"
          },
          {
            "filenamePattern": "*.mindmap.yml"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run webpack",
    "compile": "tsc -p ./",
    "webpack": "webpack --mode production",
    "webpack:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:vscode": "node ./out/test/runTest.js",
    "build-webview": "vite build --config vite.config.vscode.ts",
    "package": "pnpm exec vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^8.28.0",
    "ts-loader": "^9.5.2",
    "typescript": "^4.9.4",
    "vitest": "^3.2.4",
    "webpack": "^5.101.2",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stanah/mindmap-tool.git"
  },
  "bugs": {
    "url": "https://github.com/stanah/mindmap-tool/issues"
  },
  "homepage": "https://github.com/stanah/mindmap-tool#readme",
  "license": "MIT"
}
